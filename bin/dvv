#!/usr/bin/env node

const childProcess = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const root = path.resolve(__dirname, "..");
const binaryName = process.platform === "win32" ? "dvv.exe" : "dvv";
const binaryPath = path.join(root, "dist", binaryName);
const args = process.argv.slice(2);
const env = { ...process.env, DVV_DIR: root };
if (!env.GOCACHE) {
  env.GOCACHE = path.join(os.tmpdir(), "dvv-go-build-cache");
}

if (shouldRebuild(binaryPath)) {
  const build = childProcess.spawnSync(process.execPath, [path.join(root, "scripts", "build.js")], {
    cwd: root,
    env,
    stdio: "inherit",
    windowsHide: false,
  });
  if (build.error) {
    console.error("dvv could not rebuild.");
    console.error(build.error.message);
    process.exit(127);
  }
  if ((build.status ?? 1) !== 0) {
    process.exit(build.status ?? 1);
  }
}

let command = binaryPath;
let commandArgs = args;

if (!fs.existsSync(binaryPath)) {
  command = "go";
  commandArgs = ["run", "-buildvcs=false", "./cmd/dvv", ...args];
}

const result = childProcess.spawnSync(command, commandArgs, {
  cwd: root,
  env,
  stdio: "inherit",
  windowsHide: false,
});

if (result.error) {
  console.error("dvv could not start.");
  console.error("Run `npm run build` from the project root, or install Go for source execution.");
  console.error(result.error.message);
  process.exit(127);
}

process.exit(result.status ?? 1);

function shouldRebuild(binary) {
  if (process.env.DVV_AUTO_BUILD === "0") {
    return false;
  }
  if (!fs.existsSync(binary)) {
    return false;
  }

  const binaryMtime = fs.statSync(binary).mtimeMs;
  const sourceMtime = newestMtime([
    path.join(root, "cmd"),
    path.join(root, "internal"),
    path.join(root, "go.mod"),
    path.join(root, "dvv.config.json"),
  ]);
  return sourceMtime > binaryMtime;
}

function newestMtime(paths) {
  let newest = 0;
  for (const item of paths) {
    if (!fs.existsSync(item)) {
      continue;
    }
    const stat = fs.statSync(item);
    newest = Math.max(newest, stat.mtimeMs);
    if (stat.isDirectory()) {
      for (const child of fs.readdirSync(item)) {
        newest = Math.max(newest, newestMtime([path.join(item, child)]));
      }
    }
  }
  return newest;
}
