#!/usr/bin/env bash
set -euo pipefail

# devv - Developer Tools Router
# Resolve its true physical path, supporting symlinks:
DEVTOOLS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export DEVTOOLS_DIR

# Load local environment variables if present
if [[ -f "${DEVTOOLS_DIR}/.env" ]]; then
  set -a
  source "${DEVTOOLS_DIR}/.env"
  set +a
fi

# Shared UI and utilities
source "${DEVTOOLS_DIR}/src/lib/ui.sh"
source "${DEVTOOLS_DIR}/src/lib/config.sh"

help_entry() {
  local command="${1:-}"
  local description="${2:-}"
  printf "    ${BOLD}${CYA}%-18s${NC} %s\n" "$command" "$description"
}

show_help() {
  title "devv - Developer Tools"
  echo -e "  ${BOLD}Usage:${NC} devv <command> [args]\n"
  
  echo -e "  ${PUR}📦 Database Commands:${NC}"
  help_entry "db:create" "✨ Create a new database"
  help_entry "db:drop" "🗑️  Drop an existing database"
  help_entry "db:truncate" "🧹 Truncate all tables in a database"
  help_entry "db:import" "📥 Import a dump locally or from Google Drive"
  help_entry "db:clean" "🗑️  Clean dumps interactively from local storage"
  help_entry "db:ui" "📊 Interactive Database TUI (Harlequin)"
  echo
  
  echo -e "  ${PUR}⚡ Environment & Tmux:${NC}"
  help_entry "tmux:up" "🚀 Start development tmux session (API + Web)"
  help_entry "tmux:down" "🛑 Kill development tmux session"
  help_entry "tmux:session" "📂 Open a dir in a new tmux session via fzf"
  help_entry "tmux:window" "🪟 Open a dir in a new tmux window via fzf"
  help_entry "api:restart" "🔄 Restart the API backend and flush caches/horizon"
  help_entry "web:restart" "🌐 Restart the Web frontend"
  echo

  echo -e "  ${PUR}🧩 Workspaces:${NC}"
  help_entry "workspace" "🧭 Interactive symlink workspace manager"
  help_entry "workspace:list" "📜 List symlink workspaces"
  echo
  
  echo -e "  ${PUR}🛠️  System:${NC}"
  help_entry "env:setup" "⚙️  Install dependencies and configure zsh autocompletion"
  help_entry "env:bootstrap" "♻️  Setup + restore encrypted local secrets"
  help_entry "config:set" "🛠️  Set configuration variable"
  help_entry "config:list" "📄  List configuration variables"
  echo
  
  echo -e "  ${PUR}🌐 Network & SSH:${NC}"
  help_entry "ssh" "🔌 Interactive SSH hub via fzf (Alt+S)"
  help_entry "ssh:add" "➕ Add a new server to the SSH list"
  help_entry "ssh:remove" "❌ Remove server(s) from the SSH list"
  help_entry "ssh:list" "📜 List SSH entries"
  echo

  echo -e "  ${PUR}🐧 WSL:${NC}"
  help_entry "wsl:list" "📋 List WSL distros"
  help_entry "wsl:status" "🩺 Show WSL global status"
  help_entry "wsl:start" "▶️  Start a distro (devv wsl:start Ubuntu)"
  help_entry "wsl:stop" "⏹️  Stop a distro (devv wsl:stop Ubuntu)"
  help_entry "wsl:shutdown" "🛑 Shutdown all WSL distros"
  echo

  echo -e "  ${PUR}🖥️  Control Center:${NC}"
  help_entry "ui" "🧭 Open devv desktop control center"
  echo
}

if [[ $# -eq 0 || "$1" == "help" || "$1" == "--help" || "$1" == "-h" || "$1" == "-help" ]]; then
  show_help
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  db:create)   exec "${DEVTOOLS_DIR}/src/commands/db/create.sh" "$@" ;;
  db:drop)     exec "${DEVTOOLS_DIR}/src/commands/db/drop.sh" "$@" ;;
  db:truncate) exec "${DEVTOOLS_DIR}/src/commands/db/truncate.sh" "$@" ;;
  db:import)   exec "${DEVTOOLS_DIR}/src/commands/db/import.sh" "$@" ;;
  db:clean)    exec "${DEVTOOLS_DIR}/src/commands/db/clean.sh" "$@" ;;
  db:ui)       exec "${DEVTOOLS_DIR}/src/commands/db/ui.sh" "$@" ;;
  
  tmux:up)     exec "${DEVTOOLS_DIR}/src/commands/tmux/up.sh" "$@" ;;
  tmux:down)   exec "${DEVTOOLS_DIR}/src/commands/tmux/down.sh" "$@" ;;
  tmux:session)exec "${DEVTOOLS_DIR}/src/commands/tmux/session.sh" "$@" ;;
  tmux:window) exec "${DEVTOOLS_DIR}/src/commands/tmux/window.sh" "$@" ;;
  api:restart) exec "${DEVTOOLS_DIR}/src/commands/tmux/api-restart.sh" "$@" ;;
  web:restart) exec "${DEVTOOLS_DIR}/src/commands/tmux/web-restart.sh" "$@" ;;

  workspace)                exec "${DEVTOOLS_DIR}/src/commands/symlink-workspace-hub/hub.sh" "$@" ;;
  workspace:list)           exec "${DEVTOOLS_DIR}/src/commands/symlink-workspace-hub/list.sh" "$@" ;;
  
  env:setup)   exec "${DEVTOOLS_DIR}/src/commands/setup.sh" "$@" ;;
  env:bootstrap) exec "${DEVTOOLS_DIR}/src/commands/env/bootstrap.sh" "$@" ;;
  config:set)  exec "${DEVTOOLS_DIR}/src/commands/config/set.sh" "$@" ;;
  config:list) exec "${DEVTOOLS_DIR}/src/commands/config/list.sh" "$@" ;;
  
  ssh)         bash "${DEVTOOLS_DIR}/src/commands/ssh/hub.sh" "$@" ;;
  ssh:add)     bash "${DEVTOOLS_DIR}/src/commands/ssh/add.sh" "$@" ;;
  ssh:remove)  bash "${DEVTOOLS_DIR}/src/commands/ssh/remove.sh" "$@" ;;
  ssh:list)    bash "${DEVTOOLS_DIR}/src/commands/ssh/list.sh" "$@" ;;

  wsl:list)    exec "${DEVTOOLS_DIR}/src/commands/wsl/list.sh" "$@" ;;
  wsl:status)  exec "${DEVTOOLS_DIR}/src/commands/wsl/status.sh" "$@" ;;
  wsl:start)   exec "${DEVTOOLS_DIR}/src/commands/wsl/start.sh" "$@" ;;
  wsl:stop)    exec "${DEVTOOLS_DIR}/src/commands/wsl/stop.sh" "$@" ;;
  wsl:shutdown) exec "${DEVTOOLS_DIR}/src/commands/wsl/shutdown.sh" "$@" ;;

  ui)          exec "${DEVTOOLS_DIR}/src/commands/ui/open.sh" "$@" ;;
  
  *)
    err "Unknown command: ${COMMAND}"
    show_help
    exit 1
    ;;
esac
