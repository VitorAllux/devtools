{
  "name": "@vitorallux/dvv",
  "version": "2.0.0-alpha.1",
  "description": "Personal developer CLI for local automation.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dvv": "./bin/dvv"
  },
  "files": [
    "bin",
    "cmd",
    "internal",
    "scripts",
    "examples",
    "dvv.config.json",
    "go.mod",
    "README.md",
    "VERSION",
    "completions"
  ],
  "scripts": {
    "build": "node ./scripts/build.js",
    "setup": "node ./scripts/setup.js",
    "test": "node ./scripts/go.js test ./...",
    "vet": "node ./scripts/go.js vet ./...",
    "check": "npm run build && npm test && npm run vet",
    "postinstall": "node ./scripts/postinstall.js"
  },
  "engines": {
    "node": ">=18"
  }
}
