{
  "name": "@vitorallux/dvv",
  "version": "2.0.0-alpha.2",
  "description": "Personal developer CLI for local automation.",
  "private": true,
  "license": "MIT",
  "bin": {
    "dvv": "./bin/dvv"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "setup": "node ./scripts/setup.js",
