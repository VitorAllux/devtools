#compdef devv

_devv() {
  local line state

  _arguments -C \
    "1: :->cmds" \
    "*::arg:->args"

  case "$state" in
    cmds)
      local -a commands
      commands=(
        "db\:create:Create a new database"
        "db\:drop:Drop an existing database"
        "db\:truncate:Truncate all tables in a database"
        "db\:import:Import a dump locally or from Google Drive"
        "db\:clean:Clean dumps interactively from local storage"
        "db\:ui:Interactive Database TUI (Harlequin)"
        "tmux:Interactive tmux environment panel"
        "tmux\:up:Choose and start/open a tmux environment"
        "tmux\:down:Choose and stop a tmux environment"
        "tmux\:session:Open a dir in a new tmux session via fzf (Ctrl+F)"
        "tmux\:window:Open a dir in a new tmux window via fzf"
        "api\:restart:Choose and restart API/Horizon"
        "web\:restart:Choose and restart Web frontend"
        "workspace:Interactive git worktree workspace manager"
        "workspace\:list:List git worktree workspaces"
        "resources:Interactive local resources hub"
        "resources\:list:List detected local resources"
        "env\:setup:Install dependencies and configure zsh autocompletion"
        "env\:bootstrap:Setup + restore encrypted local secrets"
        "config\:set:Set configuration variable"
        "config\:list:List configuration variables"
        "ssh:Interactive SSH hub via fzf"
        "ssh\:add:Add a new server to the SSH list"
        "ssh\:remove:Remove server(s) from the SSH list"
        "ssh\:list:List SSH entries"
        "wsl\:list:List WSL distros"
        "wsl\:status:Show WSL global status"
        "wsl\:start:Start a WSL distro"
        "wsl\:stop:Stop a WSL distro"
        "wsl\:shutdown:Shutdown all WSL distros"
        "ui:Open devv desktop control center"
      )
      _describe -t commands 'devv commands' commands
      ;;
    args)
      case "${words[2]:-}" in
        tmux)
          local -a tmux_actions
          tmux_actions=(
            "up:Start/open the selected tmux environment"
            "down:Stop the selected tmux environment"
            "api-restart:Restart API/Horizon for the selected tmux environment"
            "web-restart:Restart Web frontend for the selected tmux environment"
          )
          _describe -t tmux-actions 'tmux actions' tmux_actions
          ;;
        workspace)
          local -a openers
          openers=(
            "auto:Choose from available openers"
            "cursor:Open with Cursor"
            "code:Open with VS Code"
            "vscode:Open with VS Code"
            "opencode:Open with OpenCode"
            "codex:Open with Codex"
            "shell:Open a shell in the workspace"
          )
          _describe -t workspace-openers 'workspace openers' openers
          ;;
      esac
      ;;
  esac
}

_devv "$@"
