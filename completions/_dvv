#compdef dvv

_dvv() {
  local state

  _arguments -C \
    "1: :->cmds" \
    "*::arg:->args"

  case "$state" in
    cmds)
      local -a commands
      commands=(
        "bootstrap:Restore AGE/Bitwarden secrets and SSH backup"
        "config:Open the configuration hub"
        "db:Open the database hub"
        "doctor:Check local dependencies and integration"
        "resources:Open the local resources hub"
        "setup:Install zsh completion and shell shortcuts"
        "ssh:Open the SSH hub"
        "tmux:Open the tmux environment hub"
        "workspace:Open the workspace hub"
      )
      _describe -t commands 'dvv commands' commands
      ;;
    args)
      case "${words[2]:-}" in
        config)
          local -a config_actions
          config_actions=(
            "list:List effective configuration values"
            "set:Persist a configuration value"
          )
          _describe -t config-actions 'config actions' config_actions
          ;;
        db)
          local -a db_actions
          db_actions=(
            "create:Create a database"
            "import:Import a local or Google Drive dump"
            "clean:Delete local dump files"
            "truncate:Truncate selected databases"
            "drop:Drop selected databases"
          )
          _describe -t db-actions 'db actions' db_actions
          ;;
        bootstrap)
          local -a bootstrap_flags
          bootstrap_flags=(
            "--force:Overwrite local SSH list from encrypted backup"
            "--skip-setup:Skip zsh completion and shortcut setup"
          )
          _describe -t bootstrap-flags 'bootstrap flags' bootstrap_flags
          ;;
        ssh)
          local -a ssh_flags
          ssh_flags=(
            "--name:Connect by SSH entry name"
            "--target:Connect to a raw SSH target"
            "--new-terminal:Open in a new terminal tab when supported"
          )
          _describe -t ssh-flags 'ssh flags' ssh_flags
          ;;
        tmux)
          local -a tmux_actions
          tmux_actions=(
            "up:Start or open the selected environment"
            "down:Stop the selected environment"
            "api-restart:Restart API and Horizon panes"
            "web-restart:Restart Web pane"
          )
          _describe -t tmux-actions 'tmux actions' tmux_actions
          ;;
      esac
      ;;
  esac
}

_dvv "$@"
